# Режим 1: Gemini Developer API (AI Studio ключ) — проще, но без Imagen 3
# (используется, если GOOGLE_GENAI_USE_VERTEXAI не включён).
GEMINI_API_KEY="AIzaSy..."
IMAGEN_MODEL="gemini-2.5-flash-image"

# Режим 2: Vertex AI / "Gemini Enterprise Agent Platform".
# Вариант 2а — Express Mode (проще всего, ключ из Vertex AI Studio, без gcloud):
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_API_KEY="AQ...."
# Вариант 2б — ADC/service account, привязанные к проекту:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
# GOOGLE_CLOUD_LOCATION="us-central1"
#
# В обоих случаях: реальный Imagen 3 (imagen-3.0-generate-002) с честным
# negative_prompt доступен, только если модель включена в Model Garden вашего
# проекта — иначе используйте gemini-2.5-flash-image даже через Vertex.
# IMAGEN_MODEL="imagen-3.0-generate-002"

VISION_MODEL="gemini-2.5-flash"
FONT_TITLE_PATH="./assets/fonts/Inter-Bold.ttf"
FONT_BODY_PATH="./assets/fonts/Inter-Regular.ttf"
